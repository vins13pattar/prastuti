{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm test && pnpm typecheck && pnpm lint && pnpm db:check && pnpm build && pnpm local:smoke",
    "local:smoke": "tsx scripts/smoke-local.ts",
    "local:persistent:smoke": "PRASTUTI_PERSISTENCE_MODE=postgres DATABASE_DRIVER=postgres-js DATABASE_URL=postgresql://prastuti:prastuti-local@127.0.0.1:54329/prastuti tsx scripts/smoke-local.ts",
    "local:postgres:verify": "DATABASE_URL=postgresql://prastuti:prastuti-local@127.0.0.1:54329/prastuti tsx scripts/verify-postgres.ts",
    "local:infra:up": "docker compose -f ../../docker-compose.yml up -d --wait",
    "local:infra:down": "docker compose -f ../../docker-compose.yml down",
    "local:infra:reset": "docker compose -f ../../docker-compose.yml down --volumes",
    "local:db:migrate": "tsx scripts/migrate-local.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.20",
    "@neondatabase/serverless": "^1.2.0",
    "@opentelemetry/api": "1.10.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/otel": "2.1.3",
    "ably": "^2.30.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.61.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.53.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "razorpay": "^2.9.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.9.1",
    "workflow": "^4.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "shadcn": "4.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
